{
  "name": "firecam-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "android:assets": "node scripts/android-assets.mjs --generate",
    "android:sync": "node scripts/build.mjs && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleRelease",
    "android:aab": "npm run android:sync && cd android && gradlew bundleRelease",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@google/genai": "^2.30.0",
    "@netlify/identity": "2.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "esbuild": "^0.25.0"
  }
}
