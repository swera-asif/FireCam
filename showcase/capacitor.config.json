{
  "appId": "app.firecam.alert",
  "appName": "FireCam",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#f5f4ef"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#f5f4ef",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
