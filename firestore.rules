rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function registered(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['fullName','phoneNumber','settings'])
    && request.resource.data.fullName is string
    && request.resource.data.fullName.size() > 0
    && request.resource.data.fullName.size() <= 100
    && request.resource.data.phoneNumber is string
    && request.resource.data.phoneNumber.size() <= 30
    && request.resource.data.settings is map;
   match /{kind}/{record} {
    allow read, delete: if owner(uid) && registered(uid)
     && kind in ['cameras','sensors','zones','alerts','contacts','floors'];
    allow create, update: if owner(uid) && existsAfter(/databases/$(database)/documents/users/$(uid))
     && kind in ['cameras','sensors','zones','alerts','contacts','floors']
     && request.resource.data.id is number
     && (kind != 'alerts' || (request.resource.data.simulated == true && request.resource.data.aiVerified == false))
     && (kind != 'cameras' || request.resource.data.status == 'offline')
     && (kind != 'sensors' || request.resource.data.status == 'unconnected');
   }
  }
 }
}

